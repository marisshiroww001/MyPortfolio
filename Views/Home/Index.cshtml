@{
    ViewData["Title"] = "Portfolio";
}

<main class="portfolio">

    <!-- HERO -->
    <section class="hero" id="home">

        <div class="hero-orbit hero-orbit-one"></div>
        <div class="hero-orbit hero-orbit-two"></div>

        <div class="hero-copy">
            <span class="eyebrow">HELLO, I'M</span>

            <h1>
                Maris Wanjiru
            </h1>

            <p class="hero-roles">
                Business Intelligence <i>✳</i>
                Software Development <i>✳</i>
                Psychology
            </p>

            <p class="hero-description">
                I turn data into insight, build digital experiences,
                and explore how technology can make a difference
                in people's lives.
            </p>

            <a class="explore-link" href="#projects">
                <span class="explore-arrow">↗</span>
                Explore my work
            </a>
        </div>

        <div class="hero-art">
            <div class="art-caption caption-top">
                <span>01 / THINK</span>
                <span>Curiosity first.</span>
            </div>

            <div class="art-frame">
                <img src="~/images/eyebrow.jpeg"
                     alt="Eyebrow photograph"
                     class="hero-image" />
                <div class="image-stamp">M.</div>

                <div class="floating-note">
                    <span>MY PHILOSOPHY</span>
                    <p>Better systems.<br />Deeper understanding.<br /><em>Human impact.</em></p>
                </div>
            </div>

            <div class="art-caption caption-bottom">
                <span>DATA × PEOPLE × TECHNOLOGY</span>
                <span>KENYA · 2026</span>
            </div>
        </div>

        <div class="hero-index">PORTFOLIO — 2026</div>
