    <!-- ABOUT -->
    <section class="about-section" id="about">

        <div class="about-art">
            <span class="collage-label">A MIND THAT WANDERS</span>
            <div class="collage-circle circle-purple"></div>
            <div class="collage-circle circle-gold"></div>

            <div class="collage-image">
                <img src="~/images/model.jpeg"
                     alt="Portrait photograph"
                     class="collage-image" />
            </div>

            <span class="collage-number">02</span>
            <span class="collage-handwriting">stay curious ♡</span>
        </div>

        <div class="about-copy">
            <span class="eyebrow">A LITTLE ABOUT ME</span>

            <h2>
                A curious mind<br />
                with a <span>purpose.</span>
            </h2>

            <p>
                I'm a Business Intelligence graduate from Strathmore
                University, interested in the space where data,
                technology, and human behaviour meet.
            </p>

            <p>
                From analysing business performance to exploring
                mental-health data and building digital projects,
                I enjoy turning complex problems into things people
                can understand and use.
            </p>

            <p class="about-signature">
                Still learning. Always building.
            </p>
        </div>

        <div class="about-disciplines">
            <article class="discipline">
                <span class="discipline-icon">↗</span>
                <div>
                    <h3>Data & Intelligence</h3>
                    <p>Finding patterns, understanding performance, and supporting better decisions.</p>
                </div>
            </article>

            <article class="discipline">
                <span class="discipline-icon">&lt;/&gt;</span>
                <div>
                    <h3>Technology</h3>
                    <p>Building useful applications and exploring creative digital solutions.</p>
                </div>
            </article>

            <article class="discipline">
                <span class="discipline-icon">◎</span>
                <div>
                    <h3>Psychology</h3>
                    <p>Understanding people, mental health, and the experiences behind the data.</p>
                </div>
            </article>
        </div>
    </section>


    <!-- PROJECTS -->
    <section class="projects-section" id="projects">

        <div class="section-heading">
            <div>
                <span class="eyebrow">SELECTED WORK / 03</span>
                <h2>Real projects.<br />Real <span>impact.</span></h2>
            </div>

            <p>
                A collection of experiments, analytical work,
                and digital experiences shaped by curiosity.
            </p>
        </div>

        <article class="project project-dilemma">
            <div class="project-visual dilemma-visual">
                <span class="project-index">PROJECT 01</span>

                <img src="~/images/homepage.png"
                     alt="The Human Dilemma Lab homepage"
                     class="project-screenshot" />

                <span class="visual-caption">HUMAN BEHAVIOUR / INTERACTIVE</span>
            </div>

            <div class="project-info">
                <span class="project-category">PYTHON · DJANGO · PSYCHOLOGY</span>
                <h3>The Human<br />Dilemma Lab</h3>
                <p>
                    An interactive experience exploring human dilemmas,
                    decision-making, and the psychology behind our choices.
                </p>

                <a class="project-link"
                   href="https://humandilemalab.onrender.com"
                   target="_blank"
                   rel="noopener noreferrer">
                    Explore project <span>↗</span>
                </a>
            </div>
        </article>

    </section>


